{
  "openapi": "3.0.0",
  "info": {
    "title": "Content Broadcasting System API",
    "description": "API collection for Content Broadcasting System",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API Base Path"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Teacher Endpoints"
    },
    {
      "name": "Principal Endpoints"
    },
    {
      "name": "Public Endpoints"
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register Teacher",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "name": "Teacher One",
                  "email": "teacher1@school.com",
                  "password": "Teacher@123",
                  "role": "teacher"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login as Teacher",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "email": "teacher1@school.com",
                  "password": "Teacher@123"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/v1/content/upload": {
      "post": {
        "tags": [
          "Teacher Endpoints"
        ],
        "summary": "Upload Content",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "title": {
                    "type": "string",
                    "example": "Algebra Basics"
                  },
                  "subject": {
                    "type": "string",
                    "example": "Maths"
                  },
                  "description": {
                    "type": "string",
                    "example": "Introduction to algebraic equations"
                  },
                  "start_time": {
                    "type": "string",
                    "example": "2024-01-01T00:00:00Z"
                  },
                  "end_time": {
                    "type": "string",
                    "example": "2025-12-31T23:59:59Z"
                  },
                  "rotation_duration": {
                    "type": "integer",
                    "example": "10"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "Bearer {{teacher_token}}"
          }
        ],
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/content/my": {
      "get": {
        "tags": [
          "Teacher Endpoints"
        ],
        "summary": "Get My Content",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "Bearer {{teacher_token}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/content/{id}": {
      "get": {
        "tags": [
          "Teacher Endpoints"
        ],
        "summary": "Get Content by ID",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "Bearer {{teacher_token}}"
          },
          {
            "name": "id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Replace with actual content ID",
            "example": "content-id-here"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/approval/pending": {
      "get": {
        "tags": [
          "Principal Endpoints"
        ],
        "summary": "Get Pending Content",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "Bearer {{principal_token}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/approval/all": {
      "get": {
        "tags": [
          "Principal Endpoints"
        ],
        "summary": "Get All Content",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "Bearer {{principal_token}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/approval/{id}/approve": {
      "patch": {
        "tags": [
          "Principal Endpoints"
        ],
        "summary": "Approve Content",
        "requestBody": {
          "content": {}
        },
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "Bearer {{principal_token}}"
          },
          {
            "name": "id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Replace with actual content ID",
            "example": "content-id-here"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/approval/{id}/reject": {
      "patch": {
        "tags": [
          "Principal Endpoints"
        ],
        "summary": "Reject Content",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "reason": "Content does not meet curriculum standards"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "Bearer {{principal_token}}"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "application/json"
          },
          {
            "name": "id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Replace with actual content ID",
            "example": "content-id-here"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/content/live/{teacherId}": {
      "get": {
        "tags": [
          "Public Endpoints"
        ],
        "summary": "Get Live Content (Filtered by Subject)",
        "parameters": [
          {
            "name": "subject",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Maths"
          },
          {
            "name": "teacherId",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Teacher ID from login response",
            "example": "{{teacher1_id}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token obtained from /auth/login endpoint"
      }
    }
  }
}