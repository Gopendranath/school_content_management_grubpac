                  "            raw: JSON.stringify({",
                  "                email: \"teacher1@school.com\",",
                  "                password: \"Teacher@123\"",
                  "            })",
                  "        }",
                  "    }, function (err, res) {",
                  "        if (!err && res.code === 200) {",
                  "            var jsonData = res.json();",
                  "            pm.collectionVariables.set(\"teacher_token\", jsonData.data.token);",
